rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // The saved look (color scheme, custom accent, light/dark). The scheme ids
    // must match SCHEME_IDS in src/lib/appearance/schemes.ts (a test checks).
    function isValidAppearance(a) {
      return a is map
        && a.keys().hasOnly(['scheme', 'accent', 'mode'])
        && a.scheme in ['amber', 'pink', 'red', 'green', 'teal', 'blue', 'purple', 'black', 'custom']
        && (!('accent' in a) || (a.accent is string && a.accent.matches('^#[0-9a-fA-F]{6}$')))
        && (!('mode' in a) || a.mode in ['light', 'dark', 'system']);
    }

    function hasValidAppearance(data) {
      return !('appearance' in data) || data.appearance == null || isValidAppearance(data.appearance);
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // One document per account holding the public profile (email, display
    // name, photo URL). A user may only ever touch their own document.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasAll(['email', 'createdAt'])
                    && hasValidAppearance(request.resource.data);
      allow update: if isOwner(userId) && hasValidAppearance(request.resource.data);
      // Account deletion goes through the `deleteAccount` Cloud Function, which
      // uses the Admin SDK and bypasses these rules. Clients cannot self-delete
      // their profile doc directly (keeps cleanup atomic across Auth/Storage).
      allow delete: if false;

      // Tracker state — the synced transactions / wallets / recurring / settings.
      // Stored as a subcollection (one doc, `tracker/state`) so the profile doc
      // stays small and the snapshot listener only watches what it needs.
      match /tracker/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Rate-limit buckets for the auth Cloud Functions. Server-only — written
    // exclusively by the Admin SDK (which bypasses rules); clients get nothing.
    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }

    // Default deny — everything not explicitly matched above is private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
