rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidFileSize(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    // Profile pictures, the only thing stored in Storage: one object per user
    // at users/{uid}/avatar, owner-only. The app uploads a 512px WebP (well
    // under 1 MB), so anything bigger, or any other path, is refused. That keeps
    // storage (no free tier outside US regions) from growing past one small
    // file per user.
    match /users/{userId}/avatar {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
                   && isValidFileSize(1)
                   && isValidImageType();
      allow delete: if isOwner(userId);
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
